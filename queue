#!/usr/bin/env python3
"""./queue — put Gazette carousels on the posting schedule, from the Mac.

    ./queue                                   list what's queued and what has gone out
    ./queue <slug> <YYYY-MM-DD> [HH:MM]       add one (default 07:30); replaces it if already queued
    ./queue --from <file.json>                add many: [{"date":..., "slug":..., "caption":...}, ...]
                                              (the gazette's gram/oct-scheduled.json works as is)
    ./queue --only instagram <slug> <date>    one platform only
    ./queue --remove <slug>                   take it off (does not delete a post already made)

Slides and caption come from ~/Projects/quackery-gazette/gram/carousels/<slug>/
(01.png … and caption.txt). Slides are converted to JPEG — Instagram's API takes
nothing else — and the queue is committed and pushed, which is all the daily
GitHub run needs. A caption in a --from file overrides caption.txt.
"""
import json
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent
SRC = Path.home() / "Projects" / "quackery-gazette" / "gram" / "carousels"
Q, P = ROOT / "queue.json", ROOT / "posted.json"


def load():
    return json.loads(Q.read_text()), json.loads(P.read_text())


def save(q, msg):
    q.sort(key=lambda e: (e["date"], e.get("time", "07:30")))
    Q.write_text(json.dumps(q, indent=1, ensure_ascii=False) + "\n")
    subprocess.run(["git", "-C", str(ROOT), "add", "-A"], check=True)
    if subprocess.run(["git", "-C", str(ROOT), "diff", "--cached", "--quiet"]).returncode == 0:
        print("nothing changed"); return
    subprocess.run(["git", "-C", str(ROOT), "commit", "-qm", msg], check=True)
    subprocess.run("gh auth switch -u snickeringpeach >/dev/null 2>&1; git pull -q --rebase && git push -q; "
                   "gh auth switch -u lfreaney >/dev/null 2>&1", shell=True, cwd=ROOT)
    print("pushed")


def add(q, slug, date, time="07:30", caption=None, only=None):
    d = SRC / slug
    pngs = sorted(d.glob("*.png"))
    if not pngs:
        sys.exit(f"no slides in {d}")
    if caption is None:
        cf = d / "caption.txt"
        if not cf.exists():
            sys.exit(f"{slug}: no caption.txt — write one or pass it in a --from file")
        caption = cf.read_text(encoding="utf-8").strip()
    out = ROOT / "images" / slug
    out.mkdir(parents=True, exist_ok=True)
    for old in out.glob("*.jpg"):
        old.unlink()
    for p in pngs[:10]:
        subprocess.run(["sips", "-s", "format", "jpeg", "-s", "formatOptions", "92", str(p),
                        "--out", str(out / (p.stem + ".jpg"))], check=True, capture_output=True)
    q[:] = [e for e in q if e["slug"] != slug]
    e = {"date": date, "time": time, "slug": slug, "caption": caption}
    if only:
        e["to"] = [only]
    q.append(e)
    print(f"  {date} {time} {slug}: {len(pngs[:10])} slides, caption {len(caption)} chars")


def main(a):
    q, posted = load()
    only = None
    if "--only" in a:
        i = a.index("--only"); only = a[i + 1]; del a[i:i + 2]
    if not a:
        for e in q:
            done = posted.get(e["slug"], {})
            state = ", ".join(f"{t} ✓" for t in ("instagram", "facebook") if t in done) or "queued"
            print(f"{e['date']} {e.get('time', '07:30')}  {e['slug']:32} {state}")
        return
    if a[0] == "--remove":
        q[:] = [e for e in q if e["slug"] != a[1]]
        return save(q, f"queue: remove {a[1]}")
    if a[0] == "--from":
        items = json.loads(Path(a[1]).read_text())
        for it in items:
            add(q, it["slug"], it["date"], it.get("time", "07:30"), it.get("caption"), only)
        return save(q, f"queue: add {len(items)} from {Path(a[1]).name}")
    add(q, a[0], a[1], a[2] if len(a) > 2 else "07:30", None, only)
    save(q, f"queue: {a[0]} on {a[1]}")


if __name__ == "__main__":
    main(sys.argv[1:])
