#!/usr/bin/env python3
"""./connect — one-time hookup to Meta. Run it once in Terminal; it asks for three
things (nothing is echoed or saved on disk), turns them into a Page token that does
not expire, finds the Gazette's Facebook Page and its Instagram account, and stores
the three values as secrets on the GitHub repo. Steps to get the three things: README.md.
"""
import getpass
import json
import subprocess
import sys
import urllib.error
import urllib.parse
import urllib.request

API = "https://graph.facebook.com/v25.0"
REPO = "snickeringpeach/gram-post"


def get(path, **p):
    url = f"{API}/{path}?" + urllib.parse.urlencode(p)
    try:
        return json.load(urllib.request.urlopen(url, timeout=60))
    except urllib.error.HTTPError as e:
        sys.exit(f"Meta said: {e.read().decode()[:400]}")


app_id = input("App ID: ").strip()
secret = getpass.getpass("App secret (hidden): ").strip()
short = getpass.getpass("User token from Graph API Explorer (hidden): ").strip()

long_user = get("oauth/access_token", grant_type="fb_exchange_token", client_id=app_id,
                client_secret=secret, fb_exchange_token=short)["access_token"]
pages = get("me/accounts", access_token=long_user, fields="id,name,access_token,instagram_business_account")["data"]
if not pages:
    sys.exit("No Facebook Pages on that token — tick pages_show_list and your Page when generating it.")
pick = [p for p in pages if "quack" in p["name"].lower()] or pages
if len(pick) > 1:
    for i, p in enumerate(pick):
        print(f"  {i}: {p['name']}")
    pick = [pick[int(input("Which Page? "))]]
page = pick[0]
ig = (page.get("instagram_business_account") or {}).get("id")
if not ig:
    sys.exit(f"Page '{page['name']}' has no Instagram professional account linked (Business Suite → Settings → Instagram).")

# A Page token minted from a long-lived user token does not expire; check it.
dbg = get("debug_token", input_token=page["access_token"], access_token=f"{app_id}|{secret}")["data"]
print(f"Page: {page['name']} ({page['id']}), Instagram {ig}, token expires: {dbg.get('expires_at') or 'never'}")
print(f"scopes: {', '.join(dbg.get('scopes', []))}")

subprocess.run("gh auth switch -u snickeringpeach >/dev/null 2>&1", shell=True)
for k, v in (("META_PAGE_TOKEN", page["access_token"]), ("META_PAGE_ID", page["id"]), ("META_IG_ID", ig)):
    subprocess.run(["gh", "secret", "set", k, "-R", REPO, "--body", v], check=True)
subprocess.run("gh auth switch -u lfreaney >/dev/null 2>&1", shell=True)
print("Connected. The next morning run posts for real; ./queue shows what's lined up.")
